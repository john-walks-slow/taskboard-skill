#!/usr/bin/env python3
"""Compatibility wrapper forwarding to skills/taskboard/scripts/taskboard."""
import os, sys
from pathlib import Path
target = Path(__file__).resolve().parents[1] / 'skills' / 'taskboard' / 'scripts' / 'taskboard'
os.execv(sys.executable, [sys.executable, str(target), *sys.argv[1:]])
